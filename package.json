{
  "name": "seekr",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/seed.test.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:crawler": "node --watch --env-file-if-exists=.env --import tsx apps/crawler/src/main.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "npm run test:coverage -w packages/core",
    "test:frontend": "npm test --prefix frontend -- --maxWorkers=1",
    "build:frontend": "npm run build --prefix frontend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "test:e2e": "node scripts/e2e.mjs",
    "bench": "node --env-file-if-exists=.env --expose-gc bench/run.mjs",
    "bench:micro": "node bench/micro.mjs",
    "bench:eval": "node bench/eval/run.mjs",
    "bench:stack": "node scripts/bench-stack.mjs",
    "seed": "node scripts/seed.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "vitest": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@eslint/js": "^9.39.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript-eslint": "^8.72.0"
  }
}
