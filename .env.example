# ==============================================================================
# Seekr Root Environment Configuration
# Copy this file to .env or configure in your deployment/docker-compose environment
# ==============================================================================

# Core Services
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017

# API Service
PORT=4000
LOG_LEVEL=info
INDEX_SNAPSHOT_PATH=./data/index.bin

# Security: Bearer token required for /admin/* routes.
# If unset in production (NODE_ENV=production), admin routes are disabled.
# If unset in development, admin routes are unprotected (with a warning).
ADMIN_TOKEN=secret-admin-token
NODE_ENV=development

# CORS: Comma-separated list of allowed origins.
# Falls back to localhost dev defaults if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Frontend Service
VITE_API_BASE_URL=http://localhost:4000
VITE_USE_MOCK=false

# Fixture exception is ignored unless NODE_ENV=test; never set for normal crawling.
# CRAWLER_TEST_ORIGIN=http://fixture:8080

# Title weight 0 reproduces body BM25; a positive value enables BM25F.
BM25_TITLE_WEIGHT=0
# Hamming distance -1 disables near-duplicate filtering; supported range -1..3.
SIMHASH_MAX_DISTANCE=3

# Keep 60 normally. Raise only for an isolated local benchmark API.
SEARCH_RATE_LIMIT_MAX=60
# Optional benchmark target; defaults to the Docker API.
SEEKR_API_URL=http://localhost:4001

