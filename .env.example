# ==============================================================================
# Seekr Root Environment Configuration
# Copy this file to .env or configure in your deployment/docker-compose environment
# ==============================================================================

# Core Services
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017

# API Service
PORT=4000
LOG_LEVEL=info
INDEX_SNAPSHOT_PATH=./data/index.json

# Security: Bearer token required for /admin/* routes.
# If unset in production (NODE_ENV=production), admin routes are disabled.
# If unset in development, admin routes are unprotected (with a warning).
ADMIN_TOKEN=secret-admin-token
NODE_ENV=development

# CORS: Comma-separated list of allowed origins.
# Falls back to localhost dev defaults if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Frontend Service
VITE_API_BASE_URL=http://localhost:4000
VITE_USE_MOCK=false

